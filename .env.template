# AiClipse ComfyUI V3 Environment Configuration
# Copy to .env and customize as needed

# =============================================================================
# CORE CONFIGURATION
# =============================================================================
TEMPLATE_NAME=qwen-multi-edit

# ComfyUI args (space-separated, overrides config.yaml)
# COMFY_ARGS="--highvram --preview-method auto"

# Skip model downloads (use pre-downloaded models)
# SKIP_MODEL_DOWNLOAD=true

# =============================================================================
# MODEL DOWNLOADS (HuggingFace)
# =============================================================================
# Required for private/gated models
# HF_TOKEN=hf_xxxxxxxxxxxxx

# =============================================================================
# MODEL DOWNLOADS (Cloudflare R2)
# =============================================================================
# For custom model storage
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=https://xxx.r2.cloudflarestorage.com

# =============================================================================
# RUNPOD SPECIFIC
# =============================================================================
# SSH access (recommended)
# PUBLIC_KEY="ssh-rsa AAAA..."
# Or password (auto-generated if not set)
# SSH_PASSWORD=

# JupyterLab (optional)
# ENABLE_JUPYTER=true
# JUPYTER_TOKEN=

# =============================================================================
# GPU CONFIGURATION
# =============================================================================
# Override GPU variant (rtx4090, rtx5090, a10g, a100, h100)
# GPU_VARIANT=a10g
